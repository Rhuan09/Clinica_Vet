<Page
    x:Class="Clinica_Vet.Views.ConsultaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Clinica_Vet.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls">

    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#0078D7" Padding="16" CornerRadius="4">
            <TextBlock Text="Gerenciamento de Consultas" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold" />
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <!-- Formulário Consulta -->
                <ColumnDefinition Width="3*" />
                <!-- Lista Consultas -->
            </Grid.ColumnDefinitions>

            <!-- Formulário Consulta -->
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Agendar / Editar Consulta" FontSize="20" FontWeight="SemiBold" />
                <DatePicker SelectedDate="{Binding DataHoraConsulta, Mode=TwoWay}" />
                <TextBox PlaceholderText="Relatório" Text="{Binding Relatorio, Mode=TwoWay}" />
                <ComboBox ItemsSource="{Binding Veterinarios}" 
                          SelectedItem="{Binding VeterinarioSelecionado, Mode=TwoWay}" 
                          DisplayMemberPath="Nome"
                          PlaceholderText="Selecione o Veterinário" />
                <ComboBox ItemsSource="{Binding Clientes}" 
                          SelectedItem="{Binding ClienteSelecionado, Mode=TwoWay}" 
                          DisplayMemberPath="Nome"
                          PlaceholderText="Selecione o Cliente" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Adicionar" Command="{Binding AdicionarConsultaCommand}" />
                    <Button Content="Editar" Command="{Binding EditarConsultaCommand}" />
                </StackPanel>
                <Button Content="Remover" Command="{Binding RemoverConsultaCommand}" />
            </StackPanel>

            <!-- Lista Consultas -->
            <toolkit:DataGrid Grid.Column="1" 
                              ItemsSource="{Binding Consultas}" 
                              AutoGenerateColumns="False" 
                              SelectionMode="Single" 
                              SelectedItem="{Binding ConsultaSelecionada, Mode=TwoWay}">
                <toolkit:DataGrid.Columns>
                    <toolkit:DataGridTextColumn Header="Data" Binding="{Binding Data}" />
                    <toolkit:DataGridTextColumn Header="Veterinário" Binding="{Binding Veterinario.Nome}" />
                    <toolkit:DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.Nome}" />
                    <toolkit:DataGridTextColumn Header="Relatório" Binding="{Binding Relatorio}" />
                </toolkit:DataGrid.Columns>
            </toolkit:DataGrid>
        </Grid>
    </Grid>
</Page>
