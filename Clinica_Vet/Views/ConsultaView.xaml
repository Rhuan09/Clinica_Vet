<Page
    x:Class="Clinica_Vet.Views.ConsultaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:Clinica_Vet.Converters">

    <Page.Resources>
        <converters:IdToVisibilityConverter x:Key="IdToVisibilityConverter" />
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
        <DataTemplate x:Key="TimeSpanItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource TimeSpanToStringConverter}}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#0078D7" Padding="16" CornerRadius="4">
            <TextBlock Text="Gerenciamento de Consultas"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold" />
        </Border>

        <!-- Botão e Lista -->
        <StackPanel Grid.Row="1" Margin="16">
            <Button Content="Adicionar Consulta"
                    Click="OnAdicionarConsultaClick"
                    Margin="0,0,0,16" />
            <toolkit:DataGrid x:Name="ConsultasDataGrid"
                              ItemsSource="{Binding Consultas}"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              SelectedItem="{Binding ConsultaSelecionada, Mode=TwoWay}"
                              SelectionChanged="OnConsultaSelecionadaChanged">
                <toolkit:DataGrid.Columns>
                    <toolkit:DataGridTextColumn Header="Data" Binding="{Binding Data}" />
                    <toolkit:DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.Nome}" />
                    <toolkit:DataGridTextColumn Header="Animal" Binding="{Binding Animal.Nome}" />
                    <toolkit:DataGridTextColumn Header="Veterinário" Binding="{Binding Veterinario.Nome}" />
                    <toolkit:DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" />
                    <toolkit:DataGridTextColumn Header="Relatório" Binding="{Binding Relatorio}" />
                </toolkit:DataGrid.Columns>
            </toolkit:DataGrid>
        </StackPanel>

        <!-- ContentDialog -->
        <ContentDialog
            x:Name="ConsultaDialog"
            Title="{Binding ConsultaSelecionada.Descricao}"
            PrimaryButtonText="Salvar"
            SecondaryButtonText="Cancelar"
            PrimaryButtonClick="OnSalvarConsultaClick"
            SecondaryButtonClick="OnCancelarConsultaClick"
            MaxHeight="600">

            <ScrollViewer>
                <StackPanel Spacing="16">
                    <!-- Cliente -->
                    <ComboBox Header="Cliente"
                              ItemsSource="{Binding Clientes}"
                              DisplayMemberPath="Nome"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ConsultaSelecionada.ClienteId, Mode=TwoWay}"
                              SelectionChanged="OnClienteSelecionadoChanged" />

                    <!-- Animal -->
                    <ComboBox Header="Animal"
                              ItemsSource="{Binding AnimaisDisponiveis}"
                              DisplayMemberPath="Nome"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ConsultaSelecionada.AnimalId, Mode=TwoWay}" />

                    <!-- Veterinário -->
                    <ComboBox Header="Veterinário"
                              ItemsSource="{Binding Veterinarios}"
                              DisplayMemberPath="Nome"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ConsultaSelecionada.VeterinarioId, Mode=TwoWay}" />

                    <!-- Descrição -->
                    <TextBox Header="Descrição"
                             Text="{Binding ConsultaSelecionada.Descricao, Mode=TwoWay}" />

                    <!-- Data -->
                    <DatePicker Header="Data"
                                Date="{Binding ConsultaSelecionada.Data, Mode=TwoWay}" />

                    <!-- Hora -->
                    <ComboBox Header="Hora"
                              ItemsSource="{Binding HorariosDisponiveis}"
                              SelectedItem="{Binding HoraSelecionada, Mode=TwoWay}"
                              ItemTemplate="{StaticResource TimeSpanItemTemplate}" />

                    <!-- Botão Excluir -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,16,0,0">
                        <Button Content="Excluir" Click="OnExcluirConsultaClick" Background="LightCoral"
                                Visibility="{Binding ConsultaSelecionada.Id, Converter={StaticResource IdToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
