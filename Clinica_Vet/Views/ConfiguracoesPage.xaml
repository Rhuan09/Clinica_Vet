<Page
    x:Class="Clinica_Vet.Views.ConfiguracoesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
    Language="pt-BR">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#0078D7" Padding="16" CornerRadius="4">
            <TextBlock Text="Configurações - Espécies"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold" />
        </Border>

        <!-- Conteúdo -->
        <StackPanel Grid.Row="1" Margin="16">
            <!-- Campo de Pesquisa -->
            <TextBox x:Name="SearchBox"
         PlaceholderText="Pesquisar espécies"
         Text="{Binding TermoPesquisa, Mode=TwoWay}"
         Margin="0,0,0,16" />

            <!-- Botão Adicionar -->
            <Button Content="Adicionar Espécie" Click="OnAdicionarEspecieClick" Margin="0,0,0,16" />

            <!-- DataGrid de Espécies -->
            <toolkit:DataGrid ItemsSource="{Binding EspeciesFiltradas}"
          AutoGenerateColumns="False"
          SelectionMode="Single"
          SelectedItem="{Binding EspecieSelecionada, Mode=TwoWay}"
          IsReadOnly="True">
                <toolkit:DataGrid.Columns>
                    <toolkit:DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                    <toolkit:DataGridTextColumn Header="Nome" Binding="{Binding Nome}" />
                    <toolkit:DataGridTemplateColumn Header="Ações">
                        <toolkit:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Editar" Click="OnEditarEspecieClick" />
                                    <Button Content="Excluir" Click="OnRemoverEspecieClick" />
                                </StackPanel>
                            </DataTemplate>
                        </toolkit:DataGridTemplateColumn.CellTemplate>
                    </toolkit:DataGridTemplateColumn>
                </toolkit:DataGrid.Columns>
            </toolkit:DataGrid>
        </StackPanel>
    </Grid>
</Page>
