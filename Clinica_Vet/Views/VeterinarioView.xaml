<Page
    x:Class="Clinica_Vet.Views.VeterinarioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#0078D7" Padding="16" CornerRadius="4">
            <TextBlock Text="Gerenciamento de Veterinários" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold" />
        </Border>

        <!-- Busca e Lista -->
        <StackPanel Grid.Row="1" Margin="16">
            <!-- Campo de busca -->
            <TextBox x:Name="SearchBox"
         PlaceholderText="Pesquisar por nome"
         TextChanged="OnSearchTextChanged"
         Margin="0,0,0,16" />


            <!-- Botão de Adicionar -->
            <Button Content="Adicionar Veterinário" Click="OnAdicionarVeterinarioClick" Margin="0,0,0,16" />

            <!-- Tabela de Veterinários -->
            <toolkit:DataGrid x:Name="VeterinariosDataGrid"
                  ItemsSource="{Binding VeterinariosFiltrados}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  SelectedItem="{Binding VeterinarioSelecionado, Mode=TwoWay}"
                  SelectionChanged="OnVeterinarioSelecionadoChanged">
                <toolkit:DataGrid.Columns>
                    <toolkit:DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                    <toolkit:DataGridTextColumn Header="Nome" Binding="{Binding Nome}" />
                    <toolkit:DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" />
                    <toolkit:DataGridTextColumn Header="Email" Binding="{Binding Email}" />
                    <toolkit:DataGridTextColumn Header="Endereço" Binding="{Binding Endereco}" />
                    <toolkit:DataGridTextColumn Header="CEP" Binding="{Binding Cep}" />
                </toolkit:DataGrid.Columns>
            </toolkit:DataGrid>
        </StackPanel>

        <!-- Janela de Detalhes do Veterinário -->
        <ContentDialog
            x:Name="VeterinarioDialog"
            Title="{Binding VeterinarioSelecionado.Nome}"
            PrimaryButtonText="Salvar"
            SecondaryButtonText="Cancelar"
            PrimaryButtonClick="OnSalvarVeterinarioClick"
            SecondaryButtonClick="OnCancelarVeterinarioClick"
            MaxWidth="600"
            MaxHeight="400">

            <StackPanel Spacing="16">
                <!-- Campos de detalhes do Veterinário -->
                <TextBox Header="Nome" Text="{Binding VeterinarioSelecionado.Nome, Mode=TwoWay}" />
                <TextBox Header="Telefone" Text="{Binding VeterinarioSelecionado.Telefone, Mode=TwoWay}" />
                <TextBox Header="Email" Text="{Binding VeterinarioSelecionado.Email, Mode=TwoWay}" />
                <TextBox Header="Endereço" Text="{Binding VeterinarioSelecionado.Endereco, Mode=TwoWay}" />
                <TextBox Header="CEP" Text="{Binding VeterinarioSelecionado.Cep, Mode=TwoWay}" />

                <!-- Botão para excluir -->
                <Button Content="Excluir Veterinário" Background="LightCoral" Click="OnExcluirVeterinarioClick" />
            </StackPanel>
        </ContentDialog>


        <ContentDialog x:Name="ConfirmDeleteDialog"
                   Title="Confirmar Exclusão"
                   PrimaryButtonText="Excluir"
                   CloseButtonText="Cancelar"
                   XamlRoot="{x:Bind XamlRoot, Mode=OneWay}"
                   PrimaryButtonClick="OnConfirmDelete">
            <TextBlock Text="Tem certeza de que deseja excluir este veterinário?" />
        </ContentDialog>

        <ContentDialog x:Name="ErrorDialog"
                       Title="Erro"
                       CloseButtonText="Ok"
                       XamlRoot="{x:Bind XamlRoot, Mode=OneWay}"
                       CloseButtonClick="OnCloseError">
            <TextBlock x:Name="ErrorMessageTextBlock" TextWrapping="Wrap" />
        </ContentDialog>

    </Grid>
</Page>
