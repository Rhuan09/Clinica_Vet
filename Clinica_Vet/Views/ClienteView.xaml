<Page
    x:Class="Clinica_Vet.Views.ClienteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#0078D7" Padding="16" CornerRadius="4">
            <TextBlock Text="Gerenciamento de Clientes" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold" />
        </Border>

        <!-- Botão e Lista -->
        <StackPanel Grid.Row="1" Margin="16">
            <TextBox PlaceholderText="Pesquisar Cliente"
             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
             Margin="0,0,0,16" />
            <Button Content="Adicionar Cliente" Click="OnAdicionarClienteClick" Margin="0,0,0,16" />
            <toolkit:DataGrid x:Name="ClientesDataGrid"
                ItemsSource="{Binding Clientes}"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              SelectedItem="{Binding ClienteSelecionado, Mode=TwoWay}"
                              SelectionChanged="OnClienteSelecionadoChanged">
                <toolkit:DataGrid.Columns>
                    <toolkit:DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                    <toolkit:DataGridTextColumn Header="Nome" Binding="{Binding Nome}" />
                    <toolkit:DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" />
                    <toolkit:DataGridTextColumn Header="Email" Binding="{Binding Email}" />
                    <toolkit:DataGridTextColumn Header="Endereço" Binding="{Binding Endereco}" />
                    <toolkit:DataGridTextColumn Header="CEP" Binding="{Binding Cep}" />
                </toolkit:DataGrid.Columns>
            </toolkit:DataGrid>
        </StackPanel>

        <!-- Floating Window -->
        <ContentDialog
            x:Name="ClienteDialog"
            Title="{Binding ClienteSelecionado.Nome}"
            PrimaryButtonText="Salvar"
            SecondaryButtonText="Cancelar"
            MaxHeight="600"
            PrimaryButtonClick="OnSalvarClienteClick"
            SecondaryButtonClick="OnCancelarClienteClick">

            <ScrollViewer>
                <StackPanel Spacing="16">
                    <!-- Informações do Cliente -->
                    <TextBlock Text="Informações do Cliente" FontSize="18" FontWeight="Bold" />
                    <TextBox Header="Nome" Text="{Binding ClienteSelecionado.Nome, Mode=TwoWay}" />
                    <TextBox Header="Telefone" Text="{Binding ClienteSelecionado.Telefone, Mode=TwoWay}" />
                    <TextBox Header="Email" Text="{Binding ClienteSelecionado.Email, Mode=TwoWay}" />
                    <TextBox Header="Endereço" Text="{Binding ClienteSelecionado.Endereco, Mode=TwoWay}" />
                    <TextBox Header="CEP" Text="{Binding ClienteSelecionado.Cep, Mode=TwoWay}" />

                    <!-- Lista de Animais -->
                    <TextBlock Text="Animais" FontSize="18" FontWeight="Bold" />
                    <toolkit:DataGrid ItemsSource="{Binding ClienteSelecionado.Animais}"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      SelectedItem="{Binding AnimalSelecionado, Mode=TwoWay}"
                                      MinHeight="200">
                        <toolkit:DataGrid.Columns>
                            <toolkit:DataGridTextColumn Header="Nome" Binding="{Binding Nome}" />
                            <toolkit:DataGridTextColumn Header="Idade" Binding="{Binding Idade}" />
                            <toolkit:DataGridTextColumn Header="Peso" Binding="{Binding Peso}" />
                            <toolkit:DataGridTextColumn Header="Espécie" Binding="{Binding Especie.Nome}" />
                        </toolkit:DataGrid.Columns>
                    </toolkit:DataGrid>

                    <!-- Botões de Ação -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,16,0,0">
                        <Button Content="Adicionar Animal" Background="LightGreen" Click="OnAdicionarAnimalClick" />
                        <Button Content="Excluir Animal" Background="LightBlue" Command="{Binding RemoverAnimalCommand}" IsEnabled="{Binding AnimalSelecionado, Converter={StaticResource NullToBooleanConverter}}"/>
                        <Button Content="Excluir Cliente" Background="LightCoral" Click="OnExcluirClienteClick" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- ContentDialog para Adicionar Animal -->
        <ContentDialog
            x:Name="AdicionarAnimalDialog"
            Title="Adicionar Animal"
            PrimaryButtonText="Salvar"
            SecondaryButtonText="Cancelar"
            PrimaryButtonClick="OnSalvarAnimalClick"
            SecondaryButtonClick="OnCancelarAnimalClick"
            MaxWidth="400">

            <StackPanel Spacing="16">
                <TextBox Header="Nome" x:Name="AnimalNomeTextBox" />
                <TextBox Header="Idade" x:Name="AnimalIdadeTextBox" />
                <TextBox Header="Peso" x:Name="AnimalPesoTextBox" />
                <ComboBox Header="Espécie"
                          x:Name="AnimalEspecieComboBox"
                          ItemsSource="{Binding EspeciesDisponiveis}"
                          DisplayMemberPath="Nome"
                          SelectedValuePath="Id" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
